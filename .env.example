# Clean24 Sales Engine -> Clean24 OS
# Set real values in .env.local (never commit .env.local) and in Vercel.

# Clean24 OS origin, e.g. https://os.clean-24.ch
CLEAN24_OS_BASE_URL=

# Optional shared secret for local/non-Vercel environments.
# Production on Vercel can use OIDC when this is empty.
SALES_ENGINE_INTEGRATION_SECRET=

# ---- Email / SMTP (Cyon mailbox) ----
# Used by the existing checklist/email flows where applicable.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Full From header, e.g. Clean24 Memis GmbH <info@clean-24.ch>
EMAIL_FROM=
# Internal inbox that receives notifications where applicable.
ADMIN_NOTIFICATION_EMAIL=

# ---- Google measurement ----
# Optional GA4 measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads account/conversion tag ID, e.g. AW-123456789.
NEXT_PUBLIC_GADS_CONVERSION_ID=

# Conversion label for the successful website lead action.
# The conversion event fires only after Clean24 OS confirms the intake.
NEXT_PUBLIC_GADS_FORM_CONVERSION_LABEL=
