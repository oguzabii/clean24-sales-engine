# Clean24 OS integration
# Set these in .env.local (never commit .env.local) and in the deployment.

# Clean24 OS form intake, e.g. https://<clean24-os-host>/api/intake/form
CLEAN24_OS_INTAKE_URL=

# Shared server-to-server secret. Sent only as x-intake-secret.
CLEAN24_OS_INTAKE_SECRET=

# Clean24 OS discount validation endpoint, e.g.
# https://<clean24-os-host>/api/intake/discount
CLEAN24_OS_DISCOUNT_VALIDATE_URL=

# Public browser-facing upload endpoint for optional customer photos/PDFs.
# Leave empty to disable photo upload; the lead form keeps working without it.
NEXT_PUBLIC_CLEAN24_LEAD_UPLOAD_URL=

# ---- Email / SMTP (Cyon mailbox) ----
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Full From header, e.g. Clean24 Memis GmbH <info@clean-24.ch>
EMAIL_FROM=
# Internal inbox that receives lead + checklist notifications
ADMIN_NOTIFICATION_EMAIL=

# ---- Google measurement / ads ----
# Google Analytics 4 measurement ID (optional if only Google Ads is used)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Ads tag/conversion ID
NEXT_PUBLIC_GADS_CONVERSION_ID=AW-XXXXXXXXXX
# Conversion label for the successful Umzugsreinigung form submission
NEXT_PUBLIC_GADS_FORM_CONVERSION_LABEL=XXXXXXXXXXXXXXX

# Meta is not part of the current Google Ads cutover.
# NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXXXXX
